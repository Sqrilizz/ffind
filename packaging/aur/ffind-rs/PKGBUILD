# Maintainer: Sqrilizz <https://github.com/Sqrilizz>

pkgname=ffind-rs
pkgver=0.2.0
pkgrel=1
pkgdesc="High-performance, multi-threaded file finder for Linux with gitignore support and fuzzy matching"
arch=(x86_64)
url="https://github.com/Sqrilizz/ffind"
license=(MIT)
depends=(glibc gcc-libs)
makedepends=(rust)
provides=(ffind)
conflicts=(ffind ffind-rs-bin)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=("fbf51285d777f6193db24da51cdf68e3dad9e812c4177f76cd8630294ac8ea20")
options=(!lto)

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target x86_64-unknown-linux-gnu
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm 755 target/release/ffind -t "$pkgdir/usr/bin"
  install -Dm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
